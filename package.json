{
  "name": "old-eden",
  "version": "0.1.0",
  "description": "Old Eden — a blockchain-native AI-driven space MMO with evolutionary mechanics and a rebirth system",
  "main": "src/core/GameEngine.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/core/index.js",
    "start": "node src/core/index.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.json",
    "lint": "eslint src/ --ext .js",
    "build:contracts": "npx hardhat compile --config hardhat.config.cjs",
    "test:contracts": "npx hardhat test --config hardhat.config.cjs",
    "deploy:contracts": "npx hardhat run scripts/deploy.js --network polygon --config hardhat.config.cjs",
    "guardian:baseline": "bash scripts/guardian-snapshot.sh --baseline",
    "guardian:compare": "bash scripts/guardian-snapshot.sh --compare",
    "guardian:report": "bash scripts/guardian-snapshot.sh --report",
    "qa": "bash scripts/qa-protocol.sh",
    "qa:full": "npm run guardian:compare && npm run qa"
  },
  "keywords": [
    "space-game",
    "mmo",
    "blockchain",
    "nft",
    "polygon",
    "procedural-generation",
    "ai",
    "game"
  ],
  "author": "Old Eden Development Team",
  "license": "MIT",
  "dependencies": {
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.3.0",
    "bcryptjs": "^2.4.3",
    "cannon-es": "^0.20.0",
    "dotenv": "^16.4.5",
    "ethers": "^6.11.1",
    "express": "^4.18.3",
    "express-rate-limit": "^8.3.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.2.2",
    "multer": "^2.1.1",
    "redis": "^4.6.13",
    "seedrandom": "^3.0.5",
    "socket.io": "^4.7.4",
    "three": "^0.163.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.3.0",
    "@gltf-transform/functions": "^4.3.0",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@openzeppelin/contracts": "^5.6.1",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "canvas": "^3.2.3",
    "chai": "^4.5.0",
    "eslint": "^8.57.0",
    "fbx-parser": "^2.1.3",
    "fbx2gltf": "^0.9.7-p1",
    "hardhat": "^2.22.1",
    "hardhat-gas-reporter": "^1.0.10",
    "jest": "^29.7.0",
    "jsdom": "^29.0.1",
    "puppeteer": "^24.40.0",
    "sharp": "^0.34.5",
    "solidity-coverage": "^0.8.17",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
