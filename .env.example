PORT=3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/oldeden
REDIS_URL=redis://localhost:6379

# Blockchain — Polygon
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_CHAIN_ID=137
PRIVATE_KEY=your_deployer_private_key_here
EDEN_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
CHARACTER_NFT_ADDRESS=0x0000000000000000000000000000000000000000

# Auth
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# AI / ML microservices
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=your_ai_service_key
AI_SERVICE_PORT=8000
USE_GPU=false
MODEL_OUTPUT_DIR=./generated
MAX_POLY_COUNT=1000000
MAX_TEXTURE_SIZE=4096

# Payments
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# File uploads (150MB default, increase for large GLB files)
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=157286400
# For large GLB files, you can increase this to 500MB (524288000) or more
# Note: Git LFS is configured to handle .glb, .gltf, .fbx files automatically

# Misc
GAME_TICK_MS=100
MAX_PLAYERS_PER_SECTOR=500
NPC_POOL_SIZE=100000
RADIATION_MUTATION_RATE=0.001
